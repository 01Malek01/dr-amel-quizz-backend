# انسخ هذا الملف ثم عدّل القيم:
#   cp .env.docker.example .env.docker
# وشغّل دائمًا مع تحديد الملف:
#   الخادم وقاعدة البيانات فقط (الواجهة على Vercel):
#     docker compose -f docker-compose.backend.yml --env-file .env.docker up -d --build
#   أو المشروع كامل على خادم واحد (خادم + قاعدة بيانات + واجهة):
#     docker compose --env-file .env.docker up -d --build
#
# الأسماء مسبوقة بـ DQ_ حتى لا تتعارض مع backend/.env الخاص بالتطوير.

# ---- إلزامي: لن يبدأ التشغيل بدونهما ----
# سلسلة عشوائية طويلة. توليدها:  openssl rand -base64 48
DQ_JWT_SECRET=
# كلمة مرور حساب المسؤول الذي يُنشأ تلقائيًا في أول تشغيل
DQ_ADMIN_PASSWORD=

# ---- حساب المسؤول الأول ----
DQ_ADMIN_NAME=Dr. Amel
DQ_ADMIN_EMAIL=admin@dramel-quizzes.com
DQ_ADMIN_USERNAME=admin

# ---- عناوين الواجهة المسموح لها (CORS) ----
# عنوان الموقع كما يفتحه المتصفح. عدة عناوين تُفصل بفاصلة، ويمكن استخدام
# النجمة بدل النطاق الفرعي لتغطية نشر المعاينة في Vercel:
#   محليًا:          http://localhost:3006
#   Vercel:          https://dr-amel-quizzes.vercel.app,https://*.vercel.app
#   نطاق خاص:        https://quizzes.example.com
# تركه فارغًا يسمح لكل العناوين — لا تفعل ذلك على الإنترنت.
DQ_CLIENT_URL=http://localhost:3006

# ---- المنفذ على 127.0.0.1 (يمرّر إليه nginx) ----
DQ_BACKEND_PORT=5007

# ---- للمشروع الكامل على خادم واحد فقط (docker-compose.yml) ----
# لا حاجة إليهما إن كانت الواجهة على Vercel.
# يُدمج في حزمة المتصفح وقت البناء (غيّره ثم أعد البناء ليأخذ مفعوله)
#   محليًا:            http://localhost:5007/api
#   على الخادم/nginx:  https://api.example.com/api
DQ_NEXT_PUBLIC_API_URL=http://localhost:5007/api
DQ_FRONTEND_PORT=3006

# ---- اختياري ----
DQ_JWT_EXPIRES_IN=7d
# ذاكرة مونغو المؤقتة بالجيجابايت: 0.5 = 512 ميجابايت (مناسب لخادم صغير)
DQ_MONGO_CACHE_GB=0.5
# سقف ذاكرة حاوية مونغو كلها
DQ_MONGO_MEM_LIMIT=1g
# إصدار صورة مونغو
DQ_MONGO_IMAGE_TAG=8
# لا تحتاجه إلا إذا رفض مونغو العمل برسالة: MongoDB cannot start ... Linux
# kernel versions 6.19 and newer (تعارض tcmalloc، SERVER-121912). الحل الرسمي
# ترقية نواة الخادم إلى 7.0.14 أو أحدث، وهذا حلّ مؤقت إلى أن تتم الترقية:
#   DQ_MONGO_GLIBC_TUNABLES=glibc.pthread.rseq=0
DQ_MONGO_GLIBC_TUNABLES=
