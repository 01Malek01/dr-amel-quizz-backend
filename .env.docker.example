# انسخ هذا الملف ثم عدّل القيم:
#   cp .env.docker.example .env.docker
# وشغّل دائمًا مع تحديد الملف:
#   docker compose --env-file .env.docker up -d --build
#
# الأسماء مسبوقة بـ DQ_ حتى لا تتعارض مع backend/.env الخاص بالتطوير.

# ---- إلزامي: لن يبدأ التشغيل بدونهما ----
# سلسلة عشوائية طويلة. توليدها:  openssl rand -base64 48
DQ_JWT_SECRET=
# كلمة مرور حساب المسؤول الذي يُنشأ تلقائيًا في أول تشغيل
DQ_ADMIN_PASSWORD=

# ---- حساب المسؤول الأول ----
DQ_ADMIN_NAME=Dr. Amel
DQ_ADMIN_EMAIL=admin@dramel-quizzes.com
DQ_ADMIN_USERNAME=admin

# ---- العناوين ----
# CLIENT_URL يُستخدم لـ CORS: عنوان الموقع كما يفتحه المتصفح
DQ_CLIENT_URL=http://localhost:3006
# يُدمج في حزمة المتصفح وقت البناء (غيّره ثم أعد البناء ليأخذ مفعوله)
#   محليًا:            http://localhost:5007/api
#   على الخادم/nginx:  https://example.com/api
DQ_NEXT_PUBLIC_API_URL=http://localhost:5007/api

# ---- المنافذ على 127.0.0.1 (يمرّر إليها nginx) ----
DQ_BACKEND_PORT=5007
DQ_FRONTEND_PORT=3006

# ---- اختياري ----
DQ_JWT_EXPIRES_IN=7d
